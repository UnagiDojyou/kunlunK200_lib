#define SUM_CHUNK 16
#include "q4-device.h"
#include "xpu/kernel/simd.h"
#ifndef SUM_CHUNK
#define SUM_CHUNK 32
#endif
// Mode 1 is the already-scaled K32 partial path, with unchanged serial FP32 sums.
__global__ void q4_sum_fast(float *out,const float *partial,const unsigned short *scales,
                         int k,int n,int batch,int first,int rows,int mode){
    if(batch!=1 || first || rows!=n || mode!=1 || k<=0 || k>16384 || k%32 || n<=0 || n>11008 || n%32)return;
    __local__ __attribute__((aligned(64))) float v[SUM_CHUNK*32],sum[32];
    int tid=cluster_id()*core_num()+core_id(),step=cluster_num()*core_num(),blocks=k/32;
    for(int tile=tid;tile<rows/32;tile+=step){
        for(int r=0;r<32;++r)sum[r]=0;
        for(int base=0;base<blocks;base+=SUM_CHUNK){
            int count=blocks-base;if(count>SUM_CHUNK)count=SUM_CHUNK;
            unsigned int offset=((unsigned int)tile*(unsigned int)blocks+(unsigned int)base)*32u;
            GM2LM(partial+offset,v,count*128);
            for(int b=0;b<count;++b)for(int r=0;r<32;r+=8)_x256_vvadd_ls(sum+r,v+b*32+r,sum+r);
        }
        LM2GM(sum,out+(unsigned int)tile*32u,128);
    }
}
