#include "xpu/kernel/sdcdnn_header.h"
#include "flash-config.h"
__global__ void kunlun_flash_pv_wide(float *out,const unsigned char *v,const float *prob,const float *peaks,const KunlunFlashConfig *cfg,int s0,int count){
 if(core_id()!=0)return;
 __local__ KunlunFlashConfig p;GM2LM(cfg,&p,sizeof(p));
 __local__ float a[8];GM2LM(peaks,a,32);for(int j=1;j<4;++j)if(a[j]>a[0])a[0]=a[j];
 int groups=p.h/p.hk,mt=(p.m+p.qt-1)/p.qt;bool grouped=p.m==1&&groups>1&&p.tg_group;
 for(int task=cluster_id();task<p.b*p.hk;task+=cluster_num()){
  int hk=task%p.hk,b=task/p.hk;
  for(int k0=0;k0<count;){
   int kk=count-k0,limit=65536/p.d;if(kk>limit)kk=limit;
   _global_ptr_ const unsigned char *vp=v+(s0+k0)*p.v[1]+hk*p.v[2]+(b/(p.b/p.bv))*p.v[3];
   xfence_lock(DMAIN_1);dma_cfg(DMA_L2_1|DMA_INT16,DMA_GM|DMA_FP16|highptr(vp),a[0]>0?a[0]:1.0f);dma_cfg_2d(kk,p.d*2,p.v[1]);dma_i_2d((void*)0,lowptr(vp),p.d*2);xfence_unlock(DMAIN_1);
   xfence_lock(DS_1);ds_shuffle_cfg_datatype(DS_INT16);ds_shuffle_cfg_blkx(p.d);ds_cfg_output_bank(16);
   for(int j=0;j<p.d/16;++j)ds_shuffle_coa(kk,&((v16i16*)0)[j*count+k0][0],(short*)0+j*16,DS_L1W);xfence_unlock(DS_1);
   k0+=kk;
  }
  for(int hg=0;hg<groups;hg+=grouped?groups:1)for(int mi=0;mi<mt;++mi){
   int h=hk*groups+hg,m0=mi*p.qt,rows=p.m-m0;if(rows>p.qt)rows=p.qt;if(grouped)rows=groups;
   _global_ptr_ const float *pp=prob+((b*p.h+h)*p.m+m0)*p.block;
   xfence_lock(DMAIN_0);dma_cfg(DMA_L2_0|DMA_INT16,DMA_GM|DMA_FP32|highptr(pp),1.0f);dma_cfg_2d(rows,count*2,p.block*4);dma_i_2d((void*)0,lowptr(pp),count*4);xfence_unlock(DMAIN_0);
   xfence_lock(DS_0);ds_shuffle_cfg_datatype(DS_INT16);ds_shuffle_cfg_blkx(count);ds_cfg_output_bank(16);
   for(int j=0;j<(rows+15)/16;++j)ds_shuffle_batch(&((v16i16*)0)[j*count][0],(short*)0+j*16*count,count,DS_L1D);xfence_unlock(DS_0);
   xfence_lock(MAC);mm_cfg_stride(1);mm_cfg_dequant_scale(a[0]*(1.0f/(32767.0f*32767.0f)));mm_cfg_basic_int16(count,rows);
   for(int j=0;j<p.d/16;++j)mm_int16((v16f32*)0+j*rows,(v16i16*)0,(v16i16*)0+j*count);xfence_unlock(MAC);
   v16f32 *e=(v16f32*)0;
   xfence_lock(EW);ew_cfg_activation_type(EW_NOACT);ew_cfg_coeff_scalar(1.0f,0.0f,0.0f);ew_cfg_findmax(0,0.0f);ew_cfg_stream_size(rows*(p.d/16));ew_cfg_col_size(16);ew_dsmadd(e,e,e,EW_L2E);xfence_unlock(EW);
   xfence_lock(RS);rs_row_cfg_stride(1,p.d/16);rs_row_cfg_loop(rows);for(int j=0;j<p.d/16;++j)rs_row_batch(&e[j][0],&e[j*rows][0],16);xfence_unlock(RS);
   _global_ptr_ float *dst=out+((b*p.h+h)*p.m+m0)*p.d;
   xfence_lock(DMAOUT);dma_cfg(DMA_GM|DMA_FP32|highptr(dst),DMA_L2R|DMA_FP32,0.0f);dma_o(lowptr(dst),e,rows*p.d*4);xfence_unlock(DMAOUT);
  }
 }
}
