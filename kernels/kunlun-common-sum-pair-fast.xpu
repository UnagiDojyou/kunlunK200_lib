#define PAIR_CHUNK 16
#include "q4-device.h"
#include "xpu/kernel/simd.h"
__global__ void pair_sum_bounded(float *out,const float *partial,const unsigned short *scales,
 int k,int n,int batch,int first,int rows,int mode,float *out1,const float *partial1){
 if(batch!=1 || first || rows!=n || mode!=1 || k<=0 || k>16384 || k%32 || n<=0 || n>11008 || n%32)return;
 __local__ __attribute__((aligned(64))) float v[PAIR_CHUNK*32],sum[32];
 int tid=cluster_id()*core_num()+core_id(),step=cluster_num()*core_num(),blocks=k/32,tiles=rows/32;
 for(int item=tid;item<2*tiles;item+=step){
  int projection=item>=tiles,tile=projection?item-tiles:item;
  auto target=projection?out1:out;auto source=projection?partial1:partial;
  for(int r=0;r<32;++r)sum[r]=0;
  for(int base=0;base<blocks;base+=PAIR_CHUNK){
   int count=blocks-base;if(count>PAIR_CHUNK)count=PAIR_CHUNK;
   unsigned int offset=((unsigned int)tile*(unsigned int)blocks+(unsigned int)base)*32u;
   GM2LM(source+offset,v,count*128);
   for(int b=0;b<count;++b)for(int r=0;r<32;r+=8)_x256_vvadd_ls(sum+r,v+b*32+r,sum+r);
  }
  LM2GM(sum,target+(unsigned int)tile*32u,128);
 }
}
