#include "xpu/kernel/cluster_header.h"
#include "fp16-device.h"

// Keep the exceptional conversion out of the inlined normal-value loop.
static __device__ __attribute__((noinline, cold)) unsigned short half_exception(float f) {
    return kunlun_to_half(f);
}

static __device__ unsigned short half_fast(float f) {
    union { float f; unsigned int u; } x;
    x.f=f;
    const unsigned int mag=x.u&0x7fffffffu;
    // Normal F16 values below the round-to-infinity threshold.
    // Keep the same round-to-nearest-even and exceptional paths as the cache writer.
    if(mag-0x38800000u>=0x477ff000u-0x38800000u)return half_exception(f);
    const unsigned int rounded=mag+0xfffu+((mag>>13)&1u);
    return ((x.u>>16)&0x8000u)|((rounded-0x38000000u)>>13);
}

__global__ void kunlun_kv_max_prefill_writer(unsigned char *dst,const unsigned char *src,
        const unsigned char *indices,const int *config,int *status,unsigned int *maxima,
        const unsigned int *) {
    __local__ int p[24],ids[256],flag[8];
    __local__ float values[512];
    __local__ unsigned short halves[512];
    __local__ unsigned int peak[8];
    GM2LM(config,p,sizeof(p));
    GM2LM(indices,ids,128*p[17]);
    flag[0]=1;
    const int words=p[17]/4;
    constexpr int chunk=512;
    const int tid=cluster_id()*core_num()+core_id(), workers=cluster_num()*core_num();
    for(int row=tid;row<128;row+=workers){
        const int target=ids[row*words];
        if(target<0||target>=p[18]||(words==2&&ids[row*2+1]!=0)){
            LM2GM(flag,status,4);
            continue;
        }
        unsigned int m0=0,m1=0,m2=0,m3=0;
        for(int base=0;base<2048;base+=chunk){
            GM2LM(src+row*8192+base*4,values,chunk*4);
            for(int j=0;j<chunk;j+=4){
                const unsigned int h0=half_fast(values[j+0]),h1=half_fast(values[j+1]);
                const unsigned int h2=half_fast(values[j+2]),h3=half_fast(values[j+3]);
                halves[j+0]=h0;halves[j+1]=h1;halves[j+2]=h2;halves[j+3]=h3;
                const unsigned int a0=h0&32767,a1=h1&32767,a2=h2&32767,a3=h3&32767;
                m0=a0>m0?a0:m0;m1=a1>m1?a1:m1;
                m2=a2>m2?a2:m2;m3=a3>m3?a3:m3;
            }
            LM2GM(halves,dst+target*p[8]+base*2,chunk*2);
        }
        unsigned int maximum=m0>m1?m0:m1;
        maximum=maximum>m2?maximum:m2;
        maximum=maximum>m3?maximum:m3;
        if(maximum>=0x7c00)LM2GM(flag,status+1,4);
        // Retain the legacy peak even if NaN forces a full scan.
        if(maximum>0x7c00) {
            maximum=0;
            for(int base=0;base<2048;base+=chunk){
                GM2LM(dst+target*p[8]+base*2,halves,chunk*2);
                for(int j=0;j<chunk;++j){
                    const unsigned int mag=halves[j]&32767;
                    if(mag<=0x7c00&&mag>maximum)maximum=mag;
                }
            }
        }
        peak[0]=maximum;
        LM2GM(peak,maxima+target,4);
    }
}
