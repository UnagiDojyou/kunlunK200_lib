#include "native-q4/quant-exact.h"
__global__ void quant_main_compact_64(int8_t *quant,float *residual,unsigned int *res_peaks,
                          const void *input,const unsigned int *peaks,
#ifdef K200_TP_QUANT_M1
                          const unsigned int *peer_peaks,float *parameters,
#endif
                          int physical_k,int is_f16
#ifdef K200_TP_QUANT_M1
                          ,int source_k
#endif
                         ){
#ifdef K200_TP_WO_INPUT_SHARE
 const int k=2048,dtype=0,logical_k=2048;
#else
 const int k=physical_k,dtype=is_f16;
#ifdef K200_TP_QUANT_M1
 const int logical_k=source_k;
#else
 const int logical_k=k;
#endif
#endif
 __local__ __attribute__((aligned(64))) float x[NEXT_CHUNK],scaled[NEXT_CHUNK];
 __local__ __attribute__((aligned(64))) unsigned int maxima[NEXT_PEAKS];
 __local__ __attribute__((aligned(64))) unsigned short halves[NEXT_CHUNK];
 __local__ __attribute__((aligned(64))) unsigned int qwords[NEXT_CHUNK/2];
 unsigned char *qout=(unsigned char*)qwords;
 int tid=cluster_id()*core_num()+core_id(),step=cluster_num()*core_num(),chunks=(k+NEXT_CHUNK-1)/NEXT_CHUNK;
 GM2LM(peaks,maxima,((chunks+15)/16)*64);
 float maximum;
#ifdef K200_TP_QUANT_M1
 if(peer_peaks){
  __local__ __attribute__((aligned(64))) unsigned int remote[NEXT_PEAKS];
  __local__ __attribute__((aligned(64))) float params[16];
#ifdef K200_TP_WO_INPUT_SHARE
  bool bad;maximum=next_peer_max(maxima,maxima,chunks,bad);
#else
  GM2LM(peer_peaks,remote,((chunks+15)/16)*64);
  bool bad;maximum=next_peer_max(maxima,remote,chunks,bad);
#endif
  // Carry non-finite input to Residual without publishing quantized output.
  if(bad){
   maxima[0]=0x7f800000u;
   for(int c=tid;c<chunks;c+=step)LM2GM(maxima,res_peaks+c,4);
   return;
  }
  if(tid==0){
   for(int j=0;j<16;++j)params[j]=0;
   params[2]=maximum;LM2GM(params,parameters,64);
  }
 }else
#endif
 {maximum=next_max(maxima,chunks);}
 float scale=maximum/127.f,inverse=127.f/maximum;
 for(int c=tid;c<chunks;c+=step){
#ifdef K200_TP_WO_INPUT_SHARE
  // The two 32-byte gaps stay zero. Quantization overwrites all other bytes.
  for(int j=8;j<16;++j){qwords[j]=0;qwords[j+16]=0;}
#else
  for(int j=0;j<NEXT_CHUNK/2;++j)qwords[j]=0;
#endif
  int start=c*NEXT_CHUNK,count=k-start;if(count>NEXT_CHUNK)count=NEXT_CHUNK;
  if(start>=logical_k){for(int j=0;j<count;++j)x[j]=0.f;}
  else if(!dtype){GM2LM((_global_ptr_ const float *)input+start,x,count*4);}
  else{GM2LM((_global_ptr_ const unsigned short *)input+start,halves,count*2);for(int j=0;j<count;++j)x[j]=q4_half(halves[j]);}
  for(int j=0;j<count;j+=8)_x256_svmul_ls(inverse,x+j,scaled+j);
  for(int j=0;j<count;++j){int q=next_round(scaled[j]);qout[(j/32)*64+j%32]=(int8_t)q;scaled[j]=(float)q;}
  for(int j=0;j<count;j+=8){_x256_svmul_ls(scale,scaled+j,scaled+j);_x256_vvsub_ls(x+j,scaled+j,x+j);}
  unsigned int m=0;for(int j=0;j<count;++j){unsigned int u=next_bits(x[j])&0x7fffffff;m=(unsigned int)max((int)m,(int)u);}
#ifdef K200_TP_WO_INPUT_SHARE
  LM2GM(x,residual+start,count*4);
  // Recompute the peer residual with the identical Main scale and rounding.
  GM2LM((_global_ptr_ const float *)peer_peaks+start,x,count*4);
  for(int j=0;j<count;j+=8)_x256_svmul_ls(inverse,x+j,scaled+j);
  for(int j=0;j<count;++j)scaled[j]=(float)next_round(scaled[j]);
  for(int j=0;j<count;j+=8){_x256_svmul_ls(scale,scaled+j,scaled+j);_x256_vvsub_ls(x+j,scaled+j,x+j);}
  for(int j=0;j<count;++j)m=(unsigned int)max((int)m,(int)(next_bits(x[j])&0x7fffffff));
  maxima[0]=m;LM2GM(maxima,res_peaks+c,4);
#else
  maxima[0]=m;LM2GM(maxima,res_peaks+c,4);LM2GM(x,residual+start,count*4);
#endif
  LM2GM(qout,quant+(long long)start*2,count*2);
 }
}
